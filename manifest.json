// Made by U2derscore //
{
  "manifest_version": 3,
  "name": "Desktop GIFs",
  "version": "0.2.0",
  "description": "Post Tenor GIFs in YouTube comments and replies from desktop.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://tenor.com/*",
    "*://www.youtube.com/*"
  ],
  "permissions": ["storage", "activeTab"],
  "background": {
    "scripts": ["src/sw.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "src/about.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "desktop-gifs@u2derscore",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/main.js"],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
